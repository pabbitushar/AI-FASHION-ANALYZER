# StyleSense AI Backend — Environment Config
# Copy to .env and update values

# Demo mode (set to false when Colab or YOLO is ready)
DEMO_MODE=true

# Google Colab API URL (paste ngrok URL from your Colab notebook)
# Example: COLAB_API_URL=https://abc123.ngrok-free.app
COLAB_API_URL=https://vitally-camping-heritage.ngrok-free.dev

# Max image upload size in bytes (10MB)
MAX_IMAGE_SIZE=10485760

# Allowed formats
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# CORS
CORS_ORIGINS=http://localhost:5173

# Local YOLO model path (only if not using Colab)
YOLO_MODEL_PATH=models/weights/yolov8n.pt
