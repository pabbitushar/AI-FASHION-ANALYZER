# ============================================
# StyleSense AI - Environment Configuration
# ============================================
# Copy this file to .env and adjust values

# ----- Backend -----
# Set to "true" for demo/mock results, "false" for real ML model
DEMO_MODE=true

# Maximum upload file size in bytes (default: 10MB)
MAX_IMAGE_SIZE=10485760

# Allowed image formats (comma-separated)
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend server port
BACKEND_PORT=8000

# Path to YOLO model weights (only needed when DEMO_MODE=false)
# Place your trained fashion YOLO model (.pt file) here
YOLO_MODEL_PATH=models/yolo_fashion.pt

# ----- Frontend -----
# Backend API URL
VITE_API_URL=http://localhost:8000
